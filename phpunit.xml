<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            `force="true"` SART. `php artisan test` once Laravel'i acar,
            `.env`'i okur (DB_CONNECTION=pgsql) ve PHPUnit'i O ORTAMLA
            baslatir. PHPUnit varsayilani `force="false"` oldugu icin ZATEN
            TANIMLI degiskeni EZMEZ; testler sessizce GELISTIRME
            VERITABANINA baglanir ve `RefreshDatabase` bir `migrate:fresh`
            ile hepsini silebilir.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <!--
            ASIL SEBEP BUYDU: `bootstrap/cache/config.php` varken `env()`
            hic okunmaz ve yukaridaki DB ayarlari YOK SAYILIR; testler
            gercek `pgsql` baglantisina duser. `dagit.sh` her dagitimda
            `optimize` calistirdigi icin onbellek sunucuda HER ZAMAN var.
            Var olmayan bir yola isaret ederek bu surecte onbellegi devre
            disi birakiyoruz.
        -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing-yok.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!--
            SQLite DEGIL AYRI BIR PostgreSQL: gocler jsonb ve ham
            `ALTER TABLE ... DROP NOT NULL` kullaniyor, SQLite'ta gocler
            calismiyor. `bys_test` ayri bir veritabani; gelistirme verisi
            `bys`de duruyor ve testler ona ASLA dokunmuyor.
            Kurulum: CREATE DATABASE bys_test OWNER bys;
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="bys_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
