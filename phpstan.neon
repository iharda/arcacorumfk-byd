includes:
    - vendor/larastan/larastan/extension.neon
    # Bilinen ve şimdilik kabul edilen bulgular burada (çoğu Eloquent ilişki
    # dönüş tipi gürültüsü). YENİ hata eklenirse analiz KIRILIR — amaç bu.
    # Temel dosyası zamanla boşaltılacak.
    - phpstan-baseline.neon

parameters:
    # 🪤 Önbellek /tmp'de PAYLAŞIMLI: bir kez root ile koşulursa dosyalar root'a
    # ait kalıyor ve sonraki `sudo -u byd` koşusu "Could not write data to cache
    # file" ile ölüyor. Proje içinde tutmak bu çakışmayı kaynağında bitirir.
    tmpDir: storage/framework/phpstan

    paths:
        - app
        - config
        - database
        - routes

    # Seviye 5'ten başlıyoruz. Kod tabanı temizlendikçe kademeli yükselecek;
    # tek seferde 9'a çıkıp 500 hatayla boğulmak işe yaramıyor.
    level: 5

    ignoreErrors:
        # Filament/Livewire dinamik özellikleri (getXProperty -> $this->x)
        - identifier: property.notFound
          path: app/Filament/*

    excludePaths:
        - app/Filament/*/Resources/*/Pages/*
